{
  "name": "farcipal-launcher",
  "version": "1.2.4",
  "description": "Farcipal Desktop Client",
  "main": "main.js",
  "author": "apomous",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win --publish always",
    "postinstall": "node scripts/fix-xmcl.js"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "@xmcl/core": "^2.12.0",
    "@xmcl/installer": "^5.4.0",
    "@xmcl/unzip": "2.2.0",
    "electron-updater": "6.8.11",
    "lzma-native": "^8.0.6",
    "mc-tunnel": "^0.2.3",
    "msmc": "^5.0.5",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "patch-package": "^8.0.1"
  },
  "build": {
    "appId": "dev.farcipal.launcher",
    "productName": "Farcipal",
    "copyright": "Copyright © 2026 apomous",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!.github/**",
      "!**/*.md",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/7zip-bin/**"
    ],
    "extraResources": [
      {
        "from": "vendor/easytier",
        "to": "easytier"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Farcipal_Setup_${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Farcipal",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Farcipal"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "apomous",
        "repo": "farcipal-launcher",
        "releaseType": "draft"
      }
    ]
  },
  "pnpm": {
    "patchedDependencies": {
      "@xmcl/unzip@2.2.0": "patches/@xmcl__unzip@2.2.0.patch"
    }
  }
}
