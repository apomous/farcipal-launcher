{
  "name": "farcipal-launcher",
  "version": "0.2.0",
  "description": "Farcipal Desktop Client",
  "main": "main.js",
  "author": "apomous",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "@xmcl/core": "^2.16.3",
    "@xmcl/installer": "^6.3.7",
    "msmc": "^5.0.5",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.farcipal.launcher",
    "productName": "Farcipal Launcher",
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "game.js",
      "loaders.js",
      "modrinth.js",
      "discord.js",
      "network.js",
      "icon.png",
      "assets.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    }
  }
}
