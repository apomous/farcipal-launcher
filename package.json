{
  "name": "farcipal-launcher",
  "version": "1.0.0",
  "description": "Farcipal Desktop Client",
  "main": "main.js",
  "author": "apomous",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "release": "electron-builder --win --publish always",
    "postinstall": "node scripts/fix-xmcl.js"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "@xmcl/core": "^2.12.0",
    "@xmcl/installer": "^5.4.0",
    "@xmcl/unzip": "2.2.0",
    "lzma-native": "^8.0.6",
    "msmc": "^5.0.5",
    "undici": "^6.21.0",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "patch-package": "^8.0.1"
  },
  "build": {
    "appId": "dev.farcipal.launcher",
    "productName": "Farcipal",
    "copyright": "Copyright © 2026 apomous",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["**/*", "!dist/**", "!.github/**", "!**/*.md", "!**/*.map"],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    }
  }
}
